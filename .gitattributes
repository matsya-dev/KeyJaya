# Auto detect text files and perform LF normalization
* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.cs text eol=crlf
*.ps1 text eol=crlf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.ini text eol=lf
*.ico binary
*.png binary
*.gif binary
*.gz binary
*.pdf binary

# Runtime indexes refer to byte offsets. Keep the complete data pack byte exact,
# including the text notices listed in its integrity manifest.
/data/** -text
/data/README.md text eol=lf
/third_party/** -text
